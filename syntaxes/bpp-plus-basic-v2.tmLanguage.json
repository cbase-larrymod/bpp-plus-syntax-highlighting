{
    "name": "Commodore BPP+ BASIC V2",
    "scopeName": "source.bpp+basicv2",

    "patterns": [
        {
            "include": "#keywords_control"
        },
        {
            "include": "#keywords_functions"
        },
        {
            "include": "#user_functions"
        },
        {
            "include": "#keywords_storage"
        },
        {
            "include": "#keywords_io_disk"
        },
        {
            "include": "#petscii_conversions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers_line"
        },
        {
            "include": "#numbers_numeric"
        },
        {
            "include": "#blitz_directives"
        },
        {
            "include": "#blitz_extension_marker"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#include_statements"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#statement_chaining"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#label_subroutine_calls"
        },
        {
            "include": "#keywords_system_vars"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#extension_symbols"
        }
     ],

    "repository": {

        "keywords_system_vars": {
            "patterns": [
                {
                    "name": "variable.language",
                    "comment": "C64 BASIC v2 reserved system variables ST and TI",
                    "match": "(?i)\\b(st|ti)\\b"
                },
                {
                    "name": "variable.language",
                    "comment": "C64 BASIC v2 reserved system variable TI$ — no trailing \\b because $ is non-word",
                    "match": "(?i)\\bti\\$"
                }
            ]
        },

        "variables": {
            "patterns": [
                {
                    "name": "variable.other",
                    "comment": "BASIC v2 variable names including optional $ or %",
                    "match": "(?i)\\b[A-Z][A-Z0-9]*[\\$%]?"
                }
            ]
        },

        "keywords_control": {
            "patterns": [
                {
                    "name": "keyword.control",
                    "comment": "BASIC v2 control statements",
                    "match": "(?i)\\b(end|for|next|gosub|goto|if|then|step|stop|return|to|on)\\b"
                }
            ]
        },

        "keywords_functions": {
            "patterns": [
                {
                    "name": "support.function",
                    "comment": "BASIC v2 standard functions without $ suffix",
                    "match": "(?i)\\b(abs|asc|atn|cos|exp|fre|int|len|log|peek|pos|rnd|sgn|sin|spc|sqr|tab|tan|usr|val)\\b"
                },
                {
                    "name": "support.function",
                    "comment": "BASIC v2 string functions with $ suffix — no trailing \\b because $ is non-word so \\b after it requires the next char to be word, which ( is not",
                    "match": "(?i)\\b(chr\\$|left\\$|mid\\$|right\\$|str\\$)"
                }
            ]
        },

        "user_functions": {
            "patterns": [
                {
                    "name": "meta.definition.function",
                    "comment": "BASIC v2 user-defined FN functions",
                    "match": "(?i)\\b(DEF\\s+FN|FN)\\s+([A-Z][A-Z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.other",
                            "comment": "DEF FN / FN keyword"
                        },
                        "2": {
                            "name": "entity.name.function.user",
                            "comment": "User-defined function name"
                        }
                    }
                }
            ]
        },

        "keywords_storage": {
            "patterns": [
                {
                    "name": "storage.type",
                    "comment": "BASIC v2 declaration keywords",
                    "match": "(?i)\\b(dim|def)\\b"
                },
                {
                    "name": "keyword.other",
                    "comment": "BASIC v2 data and assignment keywords",
                    "match": "(?i)\\b(data|let)\\b"
                }
            ]
        },

        "keywords_io_disk": {
            "patterns": [
                {
                    "name": "keyword.other",
                    "comment": "BASIC v2 I/O and disk operations",
                    "match": "(?i)\\b(print|print#|input|input#|open|close|load|list|save|restore|read|get|get#|poke|sys|run|verify|wait|clr|cmd|cont|new)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator",
                    "comment": "BASIC v2 operators",
                    "match": "(?i)(\\*|/|\\+|-|\\^|=|<>|<|>|<=|>=|and|or|not)"
                }
            ]
        },

        "numbers_line": {
            "patterns": [
                {
                    "name": "constant.numeric",
                    "comment": "BASIC v2 line numbers at the start of a line",
                    "match": "^\\s*\\d+"
                }
            ]
        },

        "numbers_numeric": {
            "patterns": [
                {
                    "name": "constant.numeric",
                    "comment": "BASIC v2 numeric constants: decimal, hexadecimal ($...), or binary (%...)",
                    "match": "(\\d+|\\$[0-9a-fA-F]+|%[01]+)"
                }
            ]
        },

        "include_statements": {
            "patterns": [
                {
                    "name": "meta.include.statement",
                    "comment": "BPP+ include statements with type and file path, e.g., !include source \"../common/file.bpp\" or !include data \"file.bpp\"",
                    "match": "(!include)\\s+(source|data)\\s+\"([^\"]+)\"",
                    "captures": {
                        "1": { "name": "meta.preprocessor" },
                        "2": { "name": "storage.type.include" },
                        "3": { "name": "string.quoted.double.include" }
                    }
                }
            ]
        },

        "labels": {
            "patterns": [
                {
                    "name": "entity.name.function",
                    "comment": "BPP+ labels ending with a colon at start of line, allows letters, digits, and underscores, but skips BASIC keywords like NEXT",
                    "match": "(?i)^\\s*(?!(?:next|return|stop|end)\\s*:)[_A-Za-z][_A-Za-z0-9]*:"
                }
            ]
        },

        "label_subroutine_calls": {
            "patterns": [
                {
                    "name": "entity.name.function",
                    "comment": "BPP+ subroutine names after GOSUB or GOTO, optionally with child using dot; allows spaces after commas",
                    "match": "(?<=\\b(gosub|goto)\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)(?:\\s*,\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?))*"
                }
            ]
        },

        "blitz_directives": {
            "patterns": [
                {
                    "name": "meta.preprocessor.blitz",
                    "comment": "rem ** form of Blitz! compiler directive — matched before comments so rem ** is not treated as a regular REM comment",
                    "begin": "(?i)^\\s*rem\\s+\\*\\*",
                    "end": "$",
                    "beginCaptures": {
                        "0": { "name": "meta.preprocessor" }
                    },
                    "patterns": [
                        {
                            "name": "keyword.other",
                            "match": "(?i)\\b(se|sa|ie|ia|ne|sp)\\b"
                        },
                        {
                            "name": "constant.numeric",
                            "match": "\\b\\d+\\b"
                        }
                    ]
                },
                {
                    "name": "meta.preprocessor.blitz",
                    "comment": "!blitz form of Blitz! compiler directive — BPP+ alternative that converts to rem ** during preprocessing",
                    "match": "(!blitz)\\s+(se|sa|ie|ia|ne|sp)(?:\\s+(\\d+))?",
                    "captures": {
                        "1": { "name": "meta.preprocessor" },
                        "2": { "name": "keyword.other" },
                        "3": { "name": "constant.numeric" }
                    }
                }
            ]
        },

        "blitz_extension_marker": {
            "patterns": [
                {
                    "name": "meta.preprocessor",
                    "comment": ":: prefix forces Blitz! to interpret the following statement at runtime rather than compiling it",
                    "match": "^\\s*::"
                }
            ]
        },

        "comments": {
            "patterns": [
                {
                    "name": "comment.line",
                    "comment": "BASIC v2 single line comment starting with REM (case-insensitive)",
                    "begin": "(?i)\\s*REM",
                    "end": "$"
                },
                {
                    "name": "comment.line",
                    "comment": "BPP+ single line comment starting with ;",
                    "begin": "^\\s*(;)",
                    "end": "$"
                }
            ]
        },

        "strings": {
            "name": "string.quoted.double",
            "comment": "Double-quoted strings, may include braced tokens (single quotes are treated as normal characters)",
            "begin": "[\"]",
            "end": "[\"]",
            "patterns": [
                {
                    "name": "meta.token.braced",
                    "comment": "Braced tokens inside strings, e.g., {XXX}, {XXX-Z}, {Y XXX-Z}",
                    "begin": "\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.keyword.begin" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.keyword.end" }
                    },
                    "patterns": [
                        {
                            "name": "constant.numeric.token-count",
                            "match": "\\b\\d+\\b"
                        },
                        {
                            "name": "support.function.token",
                            "match": "[a-zA-Z_][a-zA-Z0-9_\\-+*^@\\.]*"
                        }
                    ]
                }
            ]
        },

        "statement_chaining": {
            "patterns": [
                {
                    "name": "keyword.operator",
                    "comment": "Backslash at end of line for BPP+ statement chaining",
                    "match": "\\\\$"
                }
            ]
        },

        "petscii_conversions": {
            "patterns": [
                {
                    "name": "invalid.illegal.petscii-conversion",
                    "comment": "PETSCII characters converted to ASCII: £→\\, ←→_, ↑→^",
                    "match": "[£←↑]"
                }
            ]
        },

        "extension_symbols": {
            "patterns": [
                {
                    "name": "invalid.illegal.prof-plum-extensions",
                    "comment": "Prof. Plum's C*Base BASIC extension symbol @ — uses invalid.illegal to match petscii_conversions rendering so both stand out the same way",
                    "match": "@"
                }
            ]
        }
    }
}
